{
    "default_route_id_enabled": true,
    "use_route_short_name_for_route_id": false,
    "use_route_short_name_for_route_id_comment": "keep original route ID",
    "route_id_cleanup_regex": "\\-\\d+$",
    "route_id_not_unique_allowed": true,
    "route_id_not_unique_allowed_comment": "merge routes",
    "default_route_long_name_enabled": true,
    "route_long_name_cleaners": [
        {
            "regex": "((\\s)*(ave|dr|mt|st)\\.(\\s)*)",
            "ignore_case": true,
            "replacement": "$2$3$4",
            "comment": "clean street point"
        }
    ],
    "route_colors": [
        {
            "route_short_name_regex": "^((6|7|8)\\d{2})$",
            "color": "E4A024",
            "comment": "SCHOOL: YELLOW (from PDF map)"
        },
        {
            "route_long_name_regex": "((\\W)(express)($))",
            "color": "00BBE5",
            "comment": "EXPRESS: LIGHT BLUE (from PDF map)"
        },
        {
            "route_long_name_regex": "((\\W)(brt)($))",
            "color": "ED1C2E",
            "comment": "BRT: RED (from PDF map)"
        },
        {
            "route_id": "301",
