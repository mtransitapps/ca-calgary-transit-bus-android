    "direction_types": [
        1,
        0
    ],
    "direction_types_comment": "Cardinal directions or strings",
    "direction_finder_enabled": true,
    "direction_headsign_cleaners": [
        {
            "regex": "( \\([^(]+\\)$)",
            "comment": "ends parentheses"
        },
        {
            "regex": " stop \\w+$",
            "ignore_case": true,
            "comment": "ends with stop X"
        },
        {
            "regex": "(^(EB|WB|NB|SB|NE|NW|SE|SW)? )",
            "comment": "starts with bounds"
        },
        {
            "regex": "( (EB|WB|NB|SB|NE|NW|SE|SW)?$)",
            "comment": "ends with bounds"
        },
        {
            "regex": "( (EB|WB|NB|SB|NE|NW|SE|SW)?(\\s*@) )",
            "replacement": "$3 ",
            "comment": "bounds before at"
        }
    ],
    "allow_non_descriptive_head_signs_until": {
        "30": "20261209"
    },
    "trip_headsign_remove_via": true,
    "trip_headsign_cleaners": [
        {
            "comment": "clean slashes - needed for words/strings UPPER_CASE -> lower_case cleanup",
            "regex": "(\\w+)\\s*/\\s*(\\w+)",
            "replacement": "$1 / $2"
        },
        {
            "regex": "(\\w)\\s*@\\s*(\\w)",
            "replacement": "$1 @ $2",
            "comment": "clean at spacing"
        },
        {
            "regex": "((^|\\W)(av)(\\W|$))",
            "ignore_case": true,
            "replacement": "$2Avenue$4"
        },
        {
            "regex": "((^)(brt)(\\W))",
            "ignore_case": true
        },
        {
            "regex": "((^)(max \\w+)(\\W))",
            "ignore_case": true
        },
        {
            "regex": "((^|\\W)(mru|mount royal university)(\\W|$))",
            "ignore_case": true,
            "replacement": "$2MRU$4"
        },
        {
            "regex": "((^|\\W)(stn)(\\W|$))",
            "ignore_case": true,
            "replacement": "$2Station$4"
        },
        {
            "regex": "((^)(route )?(\\d+)($))",
            "ignore_case": true
        },
        {
            "regex": "((\\W)(express)($))",
            "ignore_case": true
        }
    ],
